<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HWAY.Payroll.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HWAY.Payroll.UI"
    xmlns:views="clr-namespace:HWAY.Payroll.UI.Views"
    Title="HWAY.Payroll.UI">

    <TabBar>
        <ShellContent
        Title="Payroll Workspace"
        ContentTemplate="{DataTemplate views:PayrollWorkspacePage}"
        Route="PayrollWorkspacePage" />

        <ShellContent
        Title="Payroll Edit"
        ContentTemplate="{DataTemplate views:PayrollRecordEditPage}"
        Route="PayrollRecordEditPage" />

        <ShellContent
        Title="Employees"
        ContentTemplate="{DataTemplate views:EmployeePage}"
        Route="EmployeePage" />

        <ShellContent
        Title="Employers"
        ContentTemplate="{DataTemplate views:EmployerPage}"
        Route="EmployerPage" />

        <ShellContent
        Title="PD7 Records"
        ContentTemplate="{DataTemplate views:PD7Page}"
        Route="PD7Page" />
        
    </TabBar>

</Shell>
