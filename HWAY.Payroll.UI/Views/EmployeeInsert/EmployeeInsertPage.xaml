<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns:views="clr-namespace:HWAY.Payroll.UI.Views"
    x:Class="HWAY.Payroll.UI.Views.EmployeeInsertPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Employee Insert">

<ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Create Employee" FontSize="24" FontAttributes="Bold"/>

            <Entry Placeholder="RP Number"
                   Text="{Binding RpNumber}" />

            <Entry Placeholder="Employee Number"
                   Text="{Binding EmployeeNumber}" />

            <Entry Placeholder="First Name"
                   Text="{Binding FirstName}" />

            <Entry Placeholder="Last Name"
                   Text="{Binding LastName}" />

            <Entry Placeholder="SIN"
                   Text="{Binding Sin}" />

            <Entry Placeholder="Address"
                   Text="{Binding Address}" />

            <Entry Placeholder="City"
                   Text="{Binding City}" />

            <Entry Placeholder="Province"
                   Text="{Binding Province}" />

            <Entry Placeholder="Postal Code"
                   Text="{Binding PostalCode}" />

            <Entry Placeholder="Email Address"
                   Keyboard="Email"
                   Text="{Binding EmailAddress}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding HasHireDate}" />
                <Label Text="Hire Date" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <DatePicker Date="{Binding HireDateDisplay}"
                        IsVisible="{Binding HasHireDate}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding HasDateOfBirth}" />
                <Label Text="Birth Date" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <DatePicker Date="{Binding DateOfBirthDisplay}"
                        IsVisible="{Binding HasDateOfBirth}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding EiExempt}" />
                <Label Text="EI Exempt" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Save Employee"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="Green"
                    TextColor="White"/>

              <Label Text="{Binding Message}"
                     HorizontalOptions="Center"
                     Margin="0,10,0,0">

              <Label.Triggers>
                     <DataTrigger TargetType="Label"
                                   Binding="{Binding IsSuccess}"
                                   Value="True">
                     <Setter Property="TextColor" Value="Green"/>
                     </DataTrigger>

                     <DataTrigger TargetType="Label"
                                   Binding="{Binding IsSuccess}"
                                   Value="False">
                     <Setter Property="TextColor" Value="Red"/>
                     </DataTrigger>
              </Label.Triggers>
              </Label>

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
