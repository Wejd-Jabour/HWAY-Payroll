<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployerPage"
    BackgroundColor="#F6F8FA"
    Title="Employer Management">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Employers" Style="{StaticResource HwayPageTitle}" />
                    <Label Text="Search, create, update, and remove employer records" Style="{StaticResource HwaySmallLabel}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Column="1"
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Employer Lookup" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Search by RP number or employer name" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Search" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry
                                    Placeholder="Enter search term..."
                                    Text="{Binding SearchText}"
                                    ReturnCommand="{Binding SearchCommand}"
                                    Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource HwayPrimaryButton}"
                            VerticalOptions="End" />

                        <Button
                            Grid.Column="2"
                            Text="+ Add New Employer"
                            Command="{Binding NewEmployerCommand}"
                            Style="{StaticResource HwaySaveButton}"
                            VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Message}" Style="{StaticResource HwayErrorMessage}" />

            <Border
                IsVisible="{Binding SearchResultsFound}"
                Style="{StaticResource HwayCardBorder}"
                Padding="0">
                <CollectionView
                    ItemsSource="{Binding Employers}"
                    SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14" ColumnDefinitions="*,170,170,140" ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployerCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        Text="{Binding EmployerName}"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        TextColor="#111827" />
                                    <Label Text="{Binding City, StringFormat='City: {0}'}" Style="{StaticResource HwaySmallLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding RpNumber}" Style="{StaticResource HwayValueLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Period #" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding PaystubPeriod}" Style="{StaticResource HwayValueLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" Spacing="2">
                                    <Label Text="PD7 Total" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding PD7TotalDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Border
                IsVisible="{Binding EmployerSelected}"
                Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Employer Details" Style="{StaticResource HwaySectionTitle}" />
                            <Label Text="Edit employer profile and payroll settings" Style="{StaticResource HwaySmallLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Cancel"
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource HwaySecondaryButton}"
                            VerticalOptions="Center" />
                    </Grid>

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="RP Number" Text="{Binding RpNumber}" IsReadOnly="{Binding IsEditMode}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="360" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Employer Name" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Employer Name" Text="{Binding EmployerName}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="360" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Address" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Address" Text="{Binding Address}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="220" Spacing="6" Margin="0,0,18,10">
                            <Label Text="City" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="City" Text="{Binding City}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="200" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Postal Code" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Postal Code" Text="{Binding PostalCode}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="240" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Employer Group" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Employer Group"
                                    ItemsSource="{Binding EmployerGroupOptions}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedEmployerGroupOption}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="160" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Period #" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry
                                    Placeholder="Period #"
                                    Keyboard="Numeric"
                                    IsEnabled="{Binding CanEditPaystubPeriod}"
                                    Text="{Binding PaystubPeriod}"
                                    Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="160" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Fee" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Fee" Keyboard="Numeric" Text="{Binding Fee}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button
                            Text="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource HwaySaveButton}" />

                        <Button
                            Text="Delete"
                            Command="{Binding DeleteCommand}"
                            IsVisible="{Binding IsEditMode}"
                            Style="{StaticResource HwayDangerButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
