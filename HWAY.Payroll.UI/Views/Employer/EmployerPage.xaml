<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployerPage"
    Title="Employer Management">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Employer Management"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <Button Text="Add Employer"
                Command="{Binding GoToAddEmployerCommand}"
                BackgroundColor="Green"
                TextColor="White"/>

        <Button Text="Update Employer"
                Command="{Binding GoToSearchEmployerCommand}"
                BackgroundColor="Blue"
                TextColor="White"/>

        <Button Text="Remove Employer"
                Command="{Binding GoToRemoveEmployerCommand}"
                BackgroundColor="Red"
                TextColor="White"/>

    </VerticalStackLayout>
</ContentPage>