<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployeeUpdatePage"
    BackgroundColor="#F6F8FA"
    Title="Update Employee">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <VerticalStackLayout Spacing="3">
                <Label Text="Update Employee" Style="{StaticResource HwayPageTitle}" />
                <Label Text="Review and update employee profile details" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Employee Information" Style="{StaticResource HwaySectionTitle}" />

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="RP Number" Text="{Binding RpNumber}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Employee Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Employee Number" Text="{Binding EmployeeNumber}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="First Name" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="First Name" Text="{Binding FirstName}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Last Name" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Last Name" Text="{Binding LastName}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="SIN" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="SIN" Text="{Binding Sin}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Address" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Address" Text="{Binding Address}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="City" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="City" Text="{Binding City}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Province" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Province" Text="{Binding Province}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Postal Code" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Postal Code" Text="{Binding PostalCode}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Email" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Email" Text="{Binding EmailAddress}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Payroll Eligibility" Style="{StaticResource HwaySubsectionTitle}" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasHireDate}" />
                            <Label Text="Hire Date" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border IsVisible="{Binding HasHireDate}" Style="{StaticResource HwayInputBorder}" WidthRequest="300" HorizontalOptions="Start">
                            <DatePicker Date="{Binding HireDateDisplay}" Style="{StaticResource HwayDatePicker}" />
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasDateOfBirth}" />
                            <Label Text="Birth Date" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border IsVisible="{Binding HasDateOfBirth}" Style="{StaticResource HwayInputBorder}" WidthRequest="300" HorizontalOptions="Start">
                            <DatePicker Date="{Binding DateOfBirthDisplay}" Style="{StaticResource HwayDatePicker}" />
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding EiExempt}" />
                            <Label Text="EI Exempt" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Button
                        Text="Save Changes"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource HwaySaveButton}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding Message}"
                Style="{StaticResource HwayErrorMessage}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
