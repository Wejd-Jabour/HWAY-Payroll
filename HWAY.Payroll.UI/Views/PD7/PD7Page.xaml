<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.PD7Page"
    BackgroundColor="#F6F8FA"
    Title="PD7 Records">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="PD7 Records" Style="{StaticResource HwayPageTitle}" />
                    <Label Text="Company remittance totals, fees, and transfer checks" Style="{StaticResource HwaySmallLabel}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Column="1"
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Company Lookup" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Search by RP number or employer name" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Company" Style="{StaticResource HwayFieldLabel}" />
                        <Border Style="{StaticResource HwayInputBorder}">
                            <Entry
                                Placeholder="Enter RP number or employer name"
                                Text="{Binding SearchText}"
                                ReturnCommand="{Binding SearchCommand}"
                                Style="{StaticResource HwayEntry}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding IsDropdownVisible}"
                        Style="{StaticResource HwayDropdownBorder}"
                        HeightRequest="220">

                        <CollectionView
                            ItemsSource="{Binding Employers}"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14,12" ColumnDefinitions="150,*" ColumnSpacing="14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding RpNumber}"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding EmployerName}"
                                            TextColor="#334155"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="220" Spacing="2" Margin="0,0,18,8">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding SelectedEmployer.RpNumber}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="320" Spacing="2" Margin="0,0,18,8">
                            <Label Text="Employer Name" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding SelectedEmployer.EmployerName}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="160" Spacing="2" Margin="0,0,18,8">
                            <Label Text="Fee" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding Fee, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="220" Spacing="2" Margin="0,0,18,8">
                            <Label Text="{Binding Year, StringFormat='PD7 Total ({0})'}" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding CalendarYearPD7Total, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Period Selection" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Choose the month and year for PD7 records" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Month" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Month"
                                    ItemsSource="{Binding Months}"
                                    ItemDisplayBinding="{Binding DisplayText}"
                                    SelectedItem="{Binding SelectedMonth}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Year" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Year"
                                    ItemsSource="{Binding YearOptions}"
                                    SelectedItem="{Binding Year, Mode=TwoWay}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="Print PD7"
                            Command="{Binding ExportPd7CsvCommand}"
                            Style="{StaticResource HwayPrimaryButton}"
                            MinimumHeightRequest="46"
                            VerticalOptions="End" />
                    </Grid>

                    <Border
                        BackgroundColor="#EEF6FF"
                        Stroke="#BFDBFE"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Padding="14,10"
                        HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView
                                WidthRequest="4"
                                HeightRequest="34"
                                BackgroundColor="#2563EB"
                                CornerRadius="2"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="Periods"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#1D4ED8" />
                                <Label
                                    Text="{Binding PeriodSummary}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Remittance Summary" Style="{StaticResource HwaySectionTitle}" />

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="190" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Gross" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding Gross, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="190" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Net Total" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding NetTotal, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="220" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Employer Contribution" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding EmployerContribution, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="170" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Active Employees" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding ActiveEmployees}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="170" Spacing="2" Margin="0,0,18,10">
                            <Label Text="PD7 Total" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding PD7Total, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Fee" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding Fee, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="170" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Transfer" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding Transfer, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>
                    </FlexLayout>

                    <Border
                        BackgroundColor="{Binding CalculationCheckStatusColor}"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Padding="12">
                        <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Calculation Check" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding CalculationCheckStatusText}" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="170,240,*" ColumnSpacing="12" RowSpacing="8">
                        <Label Grid.Column="0" Text="Received" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                        <Border
                            Grid.Column="1"
                            BackgroundColor="{Binding ReceivedStatusColor}"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Padding="10,0"
                            MinimumHeightRequest="46">
                            <Entry
                                Placeholder="Received"
                                Keyboard="Numeric"
                                Text="{Binding Received}"
                                TextChanged="OnNonNegativeNumericTextChanged"
                                Style="{StaticResource HwayEntry}" />
                        </Border>

                        <HorizontalStackLayout Grid.Column="2" Spacing="18" VerticalOptions="Center">
                            <VerticalStackLayout IsVisible="{Binding HasPaidSoFar}" WidthRequest="140" Spacing="2">
                                <Label Text="Paid So Far" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding TotalReceived, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="220" Spacing="2">
                                <Label Text="Transfer Check" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding FeeCheckStatusText}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="10">
                        <Button
                            Text="Save PD7"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource HwaySaveButton}" />

                        <Button
                            Text="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource HwaySecondaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Message}" Style="{StaticResource HwayErrorMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
