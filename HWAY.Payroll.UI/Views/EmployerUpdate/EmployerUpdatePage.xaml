<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployerUpdatePage"
    Title="Update Employer">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Update Employer"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Entry Placeholder="RP Number"
                   Text="{Binding RpNumber}" />

            <Entry Placeholder="Employer Name"
                   Text="{Binding EmployerName}" />

            <Entry Placeholder="Address"
                   Text="{Binding Address}" />

            <Entry Placeholder="City"
                   Text="{Binding City}" />

            <Entry Placeholder="Postal Code"
                   Text="{Binding PostalCode}" />

            <Entry Placeholder="Employer Group"
                   Text="{Binding EmployerGroup}" />

            <Entry Placeholder="Period #"
                   Keyboard="Numeric"
                   Text="{Binding PaystubPeriod}" />

            <Entry Placeholder="Fee"
                   Keyboard="Numeric"
                   Text="{Binding Fee}" />

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="Green"
                    TextColor="White"/>

            <Label Text="{Binding Message}"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
