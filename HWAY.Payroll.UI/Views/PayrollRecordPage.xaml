<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.PayrollRecordPage"
    BackgroundColor="#F6F8FA"
    Title="Employee Payroll Lookup">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <VerticalStackLayout Spacing="3">
                <Label Text="Employee Payroll Lookup" Style="{StaticResource HwayPageTitle}" />
                <Label Text="Find employee payroll records by employer RP number" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Employer Search" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Enter an RP number to load employee payroll records" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry
                                    Placeholder="RP Number"
                                    Keyboard="Text"
                                    Text="{Binding RpNumber}"
                                    Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Search Employees"
                            Command="{Binding SearchByRpNumberCommand}"
                            Style="{StaticResource HwayPrimaryButton}"
                            VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <CollectionView
                ItemsSource="{Binding SearchResults}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedPayrollRecord}"
                IsVisible="{Binding SearchResultsFound}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#FFFFFF"
                            Stroke="#D9E2EC"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,170" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        Text="{Binding EmployeeName}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#111827" />
                                    <Label Text="{Binding EmployeeNumber, StringFormat='Employee #: {0}'}" Style="{StaticResource HwaySmallLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding RpNumber}" Style="{StaticResource HwayValueLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border
                IsVisible="{Binding EmployeeNotFound}"
                BackgroundColor="#FEF2F2"
                Stroke="#FCA5A5"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Padding="12">
                <Label
                    Text="No employees found for that RP number."
                    TextColor="#B91C1C"
                    FontAttributes="Bold" />
            </Border>

            <Border
                IsVisible="{Binding EmployeeFound}"
                Style="{StaticResource HwayCardBorder}">

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Payroll Details" Style="{StaticResource HwaySectionTitle}" />
                            <Label Text="{Binding HireDateText, StringFormat='Hire date: {0}'}" Style="{StaticResource HwaySmallLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Calculate Payroll Deductions"
                            Command="{Binding CalculateAndOpenCraCommand}"
                            Style="{StaticResource HwayPrimaryButton}"
                            VerticalOptions="Center" />
                    </Grid>

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                            <Label Text="Earnings" Style="{StaticResource HwaySubsectionTitle}" />

                            <Grid
                                ColumnDefinitions="150,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <Label Grid.Row="0" Grid.Column="0" Text="Salary" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding Salary}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="Rate" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding Rate}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="Regular Hours" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding RegularHours}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="3" Grid.Column="0" Text="Overtime Hours" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding OvertimeHours}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="4" Grid.Column="0" Text="Public Holiday Hours" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding PublicHolidayHours}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="5" Grid.Column="0" Text="Statutory Hours" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding StatHolidayHours}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                            <Label Text="Pay and Vacation" Style="{StaticResource HwaySubsectionTitle}" />

                            <Grid
                                ColumnDefinitions="130,*"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <Label Grid.Row="0" Grid.Column="0" Text="Gross" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HwayReadOnlyInputBorder}">
                                    <Entry Text="{Binding Gross}" Keyboard="Numeric" IsReadOnly="True" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="Vacation" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HwayReadOnlyInputBorder}">
                                    <Entry Text="{Binding Vacation}" Keyboard="Numeric" IsReadOnly="True" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="Vacation Setting" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Picker
                                        ItemsSource="{Binding VacationSettingOptions}"
                                        SelectedItem="{Binding VacationSetting}"
                                        Title="Vacation setting"
                                        Style="{StaticResource HwayPicker}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                            <Label Text="Deductions" Style="{StaticResource HwaySubsectionTitle}" />

                            <Grid
                                ColumnDefinitions="130,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <Label Grid.Row="0" Grid.Column="0" Text="Tax" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding Tax1}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="CPP1" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding Cpp1}" Keyboard="Numeric" IsEnabled="{Binding CanEditCpp}" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="CPP2" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding Cpp2}" Keyboard="Numeric" IsEnabled="{Binding CanEditCpp}" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="3" Grid.Column="0" Text="EI" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding Ei}" Keyboard="Numeric" IsEnabled="{Binding CanEditEi}" Style="{StaticResource HwayEntry}" />
                                </Border>

                                <Label Grid.Row="4" Grid.Column="0" Text="Other Deduction" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                    <Entry Text="{Binding OtherDeduction}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <Label Text="{Binding Message}" Style="{StaticResource HwaySuccessMessage}" />

                    <Button
                        Text="Save Changes"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource HwaySaveButton}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
