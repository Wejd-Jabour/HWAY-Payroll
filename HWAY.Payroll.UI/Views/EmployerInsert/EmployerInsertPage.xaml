<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HWAY.Payroll.UI.Views.EmployerInsertPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F6F8FA"
    Title="Employer Insert">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <VerticalStackLayout Spacing="3">
                <Label Text="Create Employer" Style="{StaticResource HwayPageTitle}" />
                <Label Text="Add employer profile and payroll settings" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Employer Information" Style="{StaticResource HwaySectionTitle}" />

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="RP Number" Text="{Binding RpNumber}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="360" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Employer Name" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Employer Name" Text="{Binding EmployerName}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="360" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Address" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Address" Text="{Binding Address}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="240" Spacing="6" Margin="0,0,18,10">
                            <Label Text="City" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="City" Text="{Binding City}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="220" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Postal Code" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Postal Code" Text="{Binding PostalCode}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="220" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Employer Group" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Employer Group" Text="{Binding EmployerGroup}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="180" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Fee" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Fee" Keyboard="Numeric" Text="{Binding Fee}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <Button
                        Text="Save Employer"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource HwaySaveButton}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding Message}"
                HorizontalOptions="Center"
                Margin="0,10,0,0"
                FontAttributes="Bold">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsSuccess}" Value="True">
                        <Setter Property="TextColor" Value="#166534" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding IsSuccess}" Value="False">
                        <Setter Property="TextColor" Value="#B91C1C" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
