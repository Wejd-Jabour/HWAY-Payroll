<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployeeRemovePage"
    Title="Remove Employee">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- HEADER -->
            <Label Text="Remove Employee"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- SEARCH -->
            <Frame Padding="10" CornerRadius="10">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Search Employee"
                           FontAttributes="Bold"
                           FontSize="18" />

                    <Entry Placeholder="Search by RP, Employee #, or Name"
                           Text="{Binding SearchText}" />

                    <Button Text="Search"
                            Command="{Binding SearchCommand}"
                            BackgroundColor="DodgerBlue"
                            TextColor="White" />

                </VerticalStackLayout>
            </Frame>

            <!-- RESULTS -->
            <CollectionView ItemsSource="{Binding Employees}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame Padding="12"
                               Margin="5"
                               BorderColor="LightGray"
                               CornerRadius="10">

                            <Grid ColumnDefinitions="*, Auto"
                                  RowDefinitions="Auto, Auto, Auto">

                                <!-- Employee Info -->
                                <VerticalStackLayout Grid.Column="0">

                                    <Label Text="{Binding FirstName}"
                                           FontSize="16"
                                           FontAttributes="Bold"/>

                                    <Label Text="{Binding LastName}" />

                                    <Label Text="{Binding RpNumber}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                    <Label Text="{Binding EmployeeNumber}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                </VerticalStackLayout>

                                <!-- DELETE BUTTON -->
                                <Button Grid.Column="1"
                                        Text="Delete"
                                        BackgroundColor="Red"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding}" />

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- MESSAGE -->
            <Label Text="{Binding Message}"
                   HorizontalOptions="Center"
                   TextColor="DarkRed"
                   FontAttributes="Bold"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>