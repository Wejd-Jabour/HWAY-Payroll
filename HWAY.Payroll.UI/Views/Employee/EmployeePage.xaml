<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployeePage"
    Title="Employee Management">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            
            <!-- Title -->
            <Label Text="Employees" FontSize="24" FontAttributes="Bold"/>
            
            <!-- Search Bar -->
            <Label Text="Search by RP number, Employee #, or Name" FontSize="14"/>
            <Entry Placeholder="Enter search term..."
                   Text="{Binding SearchText}"
                   ReturnCommand="{Binding SearchCommand}"/>
            <Button Text="Search"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="Blue"
                    TextColor="White"/>

            <!-- Add New Button -->
            <Button Text="+ Add New Employee"
                    Command="{Binding NewEmployeeCommand}"
                    BackgroundColor="Green"
                    TextColor="White"/>

            <!-- Message -->
            <Label Text="{Binding Message}"
                   TextColor="Red"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <!-- Activity Indicator -->
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                             IsRunning="{Binding IsBusy}"/>

            <!-- Employee Results Box (styled like PayrollWorkspacePage) -->
            <Border IsVisible="{Binding SearchResultsFound}"
                    StrokeThickness="1"
                    Padding="0"
                    Margin="0,12,0,0">
                <CollectionView ItemsSource="{Binding Employees}"
                               SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployeeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding FirstName, StringFormat='Name: {0}'}"
                                           FontAttributes="Bold"
                                           FontSize="14"/>
                                    <Label Text="{Binding EmployeeNumber, StringFormat='Employee #: {0}'}"
                                           FontSize="12"/>
                                    <Label Text="{Binding RpNumber, StringFormat='RP #: {0}'}"
                                           FontSize="12"/>
                                    <Label Text="{Binding EmailAddress}"
                                           FontSize="11"
                                           Opacity="0.7"/>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Edit Form -->
            <Border IsVisible="{Binding EmployeeSelected}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,12,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding IsEditMode, StringFormat='Edit Employee|New Employee'}"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Entry Placeholder="RP Number"
                           Text="{Binding RpNumber}"
                           IsReadOnly="{Binding IsEditMode}"/>

                    <Entry Placeholder="Employee Number"
                           Text="{Binding EmployeeNumber}"
                           IsReadOnly="{Binding IsEditMode}"/>

                    <Entry Placeholder="First Name"
                           Text="{Binding FirstName}"/>

                    <Entry Placeholder="Last Name"
                           Text="{Binding LastName}"/>

                    <Entry Placeholder="SIN"
                           Text="{Binding Sin}"/>

                    <Entry Placeholder="Address"
                           Text="{Binding Address}"/>

                    <Entry Placeholder="City"
                           Text="{Binding City}"/>

                    <Entry Placeholder="Province"
                           Text="{Binding Province}"/>

                    <Entry Placeholder="Postal Code"
                           Text="{Binding PostalCode}"/>

                    <Entry Placeholder="Email"
                           Text="{Binding EmailAddress}"/>

                    <!-- Action Buttons -->
                    <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                        <Button Text="Save"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="Green"
                                TextColor="White"
                                HorizontalOptions="Fill"/>

                        <Button Text="Delete"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding IsEditMode}"
                                BackgroundColor="Red"
                                TextColor="White"
                                HorizontalOptions="Fill"/>
                    </HorizontalStackLayout>

                    <Button Text="Cancel"
                            Command="{Binding ClearFormCommand}"
                            BackgroundColor="Gray"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>