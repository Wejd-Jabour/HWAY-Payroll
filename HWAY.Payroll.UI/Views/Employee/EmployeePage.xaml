<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployeePage"
    BackgroundColor="#F6F8FA"
    Title="Employee Management">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Employees" Style="{StaticResource HwayPageTitle}" />
                    <Label Text="Search, create, update, and remove employee records" Style="{StaticResource HwaySmallLabel}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Column="1"
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Employer Filter" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Choose an employer before searching or adding employees" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Company" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry
                                    Placeholder="Enter RP number or employer name"
                                    Text="{Binding EmployerSearchText}"
                                    ReturnCommand="{Binding SearchEmployersCommand}"
                                    Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Search Companies"
                            Command="{Binding SearchEmployersCommand}"
                            Style="{StaticResource HwayPrimaryButton}"
                            VerticalOptions="End" />
                    </Grid>

                    <Border Style="{StaticResource HwayDropdownBorder}" HeightRequest="220">
                        <CollectionView
                            ItemsSource="{Binding Employers}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14,12" ColumnDefinitions="150,*" ColumnSpacing="14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEmployerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding RpNumber}"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding EmployerName}"
                                            TextColor="#334155"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <Label
                        IsVisible="{Binding HasSelectedEmployer}"
                        Text="{Binding SelectedEmployerSummary, StringFormat='Selected: {0}'}"
                        Style="{StaticResource HwayValueLabel}" />

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <Grid
                        IsVisible="{Binding HasSelectedEmployer}"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Employee Search" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry
                                    Placeholder="Search by Employee # or Name"
                                    Text="{Binding SearchText}"
                                    ReturnCommand="{Binding SearchCommand}"
                                    Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource HwayPrimaryButton}"
                            VerticalOptions="End" />

                        <Button
                            Grid.Column="2"
                            Text="+ Add New Employee"
                            Command="{Binding NewEmployeeCommand}"
                            Style="{StaticResource HwaySaveButton}"
                            VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Message}" Style="{StaticResource HwayErrorMessage}" />

            <Border
                IsVisible="{Binding SearchResultsFound}"
                Style="{StaticResource HwayCardBorder}"
                Padding="0">
                <CollectionView
                    ItemsSource="{Binding Employees}"
                    SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14" ColumnDefinitions="*,160,180,220" ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployeeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        Text="{Binding FirstName, StringFormat='Name: {0}'}"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        TextColor="#111827" />
                                    <Label Text="{Binding LastName}" Style="{StaticResource HwaySmallLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Employee #" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding EmployeeNumber}" Style="{StaticResource HwayValueLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding RpNumber}" Style="{StaticResource HwayValueLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" Spacing="2">
                                    <Label Text="Email" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Text="{Binding EmailAddress}" Style="{StaticResource HwaySmallLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Border
                IsVisible="{Binding EmployeeSelected}"
                Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Employee Details" Style="{StaticResource HwaySectionTitle}" />
                            <Label Text="Edit employee profile and payroll eligibility" Style="{StaticResource HwaySmallLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Cancel"
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource HwaySecondaryButton}"
                            VerticalOptions="Center" />
                    </Grid>

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="RP Number" Text="{Binding RpNumber}" IsReadOnly="{Binding IsRpNumberReadOnly}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Employee Number" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Employee Number" Text="{Binding EmployeeNumber}" IsReadOnly="{Binding IsEditMode}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="First Name" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="First Name" Text="{Binding FirstName}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Last Name" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Last Name" Text="{Binding LastName}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="SIN" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="SIN" Text="{Binding Sin}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="300" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Address" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Address" Text="{Binding Address}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="220" Spacing="6" Margin="0,0,18,10">
                            <Label Text="City" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="City" Text="{Binding City}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="180" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Province" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Province" Text="{Binding Province}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="200" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Postal Code" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Postal Code" Text="{Binding PostalCode}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="320" Spacing="6" Margin="0,0,18,10">
                            <Label Text="Email" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry Placeholder="Email" Text="{Binding EmailAddress}" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Payroll Eligibility" Style="{StaticResource HwaySubsectionTitle}" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasHireDate}" />
                            <Label Text="Hire Date" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border IsVisible="{Binding HasHireDate}" Style="{StaticResource HwayInputBorder}" WidthRequest="300" HorizontalOptions="Start">
                            <DatePicker Date="{Binding HireDateDisplay}" Style="{StaticResource HwayDatePicker}" />
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasDateOfBirth}" />
                            <Label Text="Birth Date" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border IsVisible="{Binding HasDateOfBirth}" Style="{StaticResource HwayInputBorder}" WidthRequest="300" HorizontalOptions="Start">
                            <DatePicker Date="{Binding DateOfBirthDisplay}" Style="{StaticResource HwayDatePicker}" />
                        </Border>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding EiExempt}" />
                            <Label Text="EI Exempt" Style="{StaticResource HwayValueLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button
                            Text="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource HwaySaveButton}" />

                        <Button
                            Text="Delete"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                            IsVisible="{Binding IsEditMode}"
                            Style="{StaticResource HwayDangerButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
