<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns:views="clr-namespace:HWAY.Payroll.UI.Views"
    x:Class="HWAY.Payroll.UI.Views.EmployerLookupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F6F8FA"
    Title="Employer Lookup">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Employer RP Lookup" Style="{StaticResource HwayPageTitle}" />
                    <Label Text="Find employer details and preview the paystub view" Style="{StaticResource HwaySmallLabel}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Column="1"
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Company Lookup" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Search by RP number or employer name" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Company" Style="{StaticResource HwayFieldLabel}" />
                        <Border Style="{StaticResource HwayInputBorder}">
                            <Entry
                                Placeholder="Enter RP number or employer name"
                                Text="{Binding SearchText}"
                                ReturnCommand="{Binding SearchCommand}"
                                Style="{StaticResource HwayEntry}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding IsDropdownVisible}"
                        Style="{StaticResource HwayDropdownBorder}"
                        HeightRequest="220">

                        <CollectionView
                            ItemsSource="{Binding Employers}"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14,12" ColumnDefinitions="150,*" ColumnSpacing="14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding RpNumber}"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding EmployerName}"
                                            TextColor="#334155"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selected Employer" Style="{StaticResource HwaySectionTitle}" />

                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start"
                            JustifyContent="Start">

                            <VerticalStackLayout WidthRequest="220" Spacing="2" Margin="0,0,18,8">
                                <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.RpNumber}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="320" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Employer Name" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.EmployerName}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="300" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Address" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.Address}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="180" Spacing="2" Margin="0,0,18,8">
                                <Label Text="City" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.City}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Postal Code" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.PostalCode}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Group" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.EmployerGroup}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button
                            Text="Open Website"
                            Clicked="OpenWebsiteButton_Clicked"
                            Style="{StaticResource HwaySecondaryButton}" />

                        <Button
                            Text="Show Paystub"
                            Command="{Binding ShowPaystubCommand}"
                            IsEnabled="{Binding CanShowPaystub}"
                            Style="{StaticResource HwayPrimaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ScrollView
                Orientation="Both"
                IsVisible="{Binding IsPaystubVisible}"
                BackgroundColor="White">

                <views:PaystubTemplate
                    x:Name="PaystubView"
                    BindingContext="{Binding SelectedEmployer}" />

            </ScrollView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
