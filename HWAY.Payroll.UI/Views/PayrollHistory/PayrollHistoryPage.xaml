<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.PayrollHistoryPage"
    BackgroundColor="#F6F8FA"
    Title="Payroll History">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Payroll History" Style="{StaticResource HwayPageTitle}" />
                    <Label Text="Saved payroll snapshots by company, term, year, month, period, and employee" Style="{StaticResource HwaySmallLabel}" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Button
                        Text="Back"
                        Command="{Binding DeselectEmployerCommand}"
                        IsVisible="{Binding HasSelectedEmployer}"
                        Style="{StaticResource HwaySecondaryButton}" />

                    <ActivityIndicator
                        IsVisible="{Binding IsBusy}"
                        IsRunning="{Binding IsBusy}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Company Lookup" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Search by RP number or employer name" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        IsVisible="{Binding NeedsEmployerSelection}"
                        Spacing="6">
                        <Label Text="Company" Style="{StaticResource HwayFieldLabel}" />
                        <Border Style="{StaticResource HwayInputBorder}">
                            <Entry
                                Placeholder="Enter RP number or employer name"
                                Text="{Binding SearchText}"
                                ReturnCommand="{Binding SearchCommand}"
                                Style="{StaticResource HwayEntry}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding IsDropdownVisible}"
                        Style="{StaticResource HwayDropdownBorder}"
                        HeightRequest="220">

                        <CollectionView
                            ItemsSource="{Binding Employers}"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14,12" ColumnDefinitions="150,*" ColumnSpacing="14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding RpNumber}"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding EmployerName}"
                                            TextColor="#334155"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <BoxView
                        IsVisible="{Binding HasSelectedEmployer}"
                        HeightRequest="1"
                        BackgroundColor="#E2E8F0" />

                    <FlexLayout
                        IsVisible="{Binding HasSelectedEmployer}"
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="220" Spacing="2" Margin="0,0,18,8">
                            <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding SelectedEmployer.RpNumber}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="320" Spacing="2" Margin="0,0,18,8">
                            <Label Text="Employer Name" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding SelectedEmployer.EmployerName}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="160" Spacing="2" Margin="0,0,18,8">
                            <Label Text="Current Period" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding SelectedEmployer.PaystubPeriod}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="180" Spacing="2" Margin="0,0,18,8">
                            <Label Text="Current Group" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding SelectedEmployer.EmployerGroup}" Style="{StaticResource HwayValueLabel}" />
                        </VerticalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding HasSelectedEmployer}"
                Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="History Filters" Style="{StaticResource HwaySectionTitle}" />
                        <Label Text="Choose the saved payroll set to review" Style="{StaticResource HwaySmallLabel}" />
                    </VerticalStackLayout>

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="End"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="240" Spacing="6" Margin="0,0,12,8">
                            <Label Text="Term" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Term"
                                    ItemsSource="{Binding TermOptions}"
                                    ItemDisplayBinding="{Binding DisplayText}"
                                    SelectedItem="{Binding SelectedTerm}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="150" Spacing="6" Margin="0,0,12,8">
                            <Label Text="Year" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Year"
                                    ItemsSource="{Binding YearOptions}"
                                    SelectedItem="{Binding SelectedYear}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="210" Spacing="6" Margin="0,0,12,8">
                            <Label Text="Month" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Month"
                                    ItemsSource="{Binding MonthOptions}"
                                    ItemDisplayBinding="{Binding DisplayText}"
                                    SelectedItem="{Binding SelectedMonth}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="150" Spacing="6" Margin="0,0,12,8">
                            <Label Text="Period" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Picker
                                    Title="Period"
                                    ItemsSource="{Binding PeriodOptions}"
                                    SelectedItem="{Binding SelectedPeriod}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="260" Spacing="6" Margin="0,0,12,8">
                            <Label Text="Employee" Style="{StaticResource HwayFieldLabel}" />
                            <Border Style="{StaticResource HwayInputBorder}">
                                <Entry
                                    Placeholder="Name or employee #"
                                    Text="{Binding EmployeeSearchText}"
                                    ReturnCommand="{Binding RefreshHistoryCommand}"
                                    Style="{StaticResource HwayEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,8">
                            <Button
                                Text="Load History"
                                Command="{Binding RefreshHistoryCommand}"
                                Style="{StaticResource HwayPrimaryButton}" />

                            <Button
                                Text="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource HwaySecondaryButton}" />
                        </HorizontalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding SearchResultsFound}"
                Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="History Summary" Style="{StaticResource HwaySectionTitle}" />

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Employees" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding EmployeeCount}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Records" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding RecordCount}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="190" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Gross" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding Gross, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="190" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Total Pay" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding TotalPay, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="190" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Deductions" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding TotalDeductions, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="190" Spacing="2" Margin="0,0,18,10">
                            <Label Text="Net Pay" Style="{StaticResource HwayFieldLabel}" />
                            <Label Text="{Binding NetPay, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                        </VerticalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding HistoryNotFound}"
                BackgroundColor="#FEF2F2"
                Stroke="#FCA5A5"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Padding="12">
                <Label
                    Text="No payroll history found for the selected filters."
                    TextColor="#B91C1C"
                    FontAttributes="Bold" />
            </Border>

            <Label Text="{Binding Message}" Style="{StaticResource HwayErrorMessage}" />

            <VerticalStackLayout
                IsVisible="{Binding SearchResultsFound}"
                BindableLayout.ItemsSource="{Binding Records}"
                Spacing="14">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HwayCardBorder}">
                            <VerticalStackLayout Spacing="14">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label
                                            Text="{Binding EmployeeName}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#111827" />

                                        <Label
                                            Text="{Binding EmployeeNumber, StringFormat='Employee #: {0}'}"
                                            Style="{StaticResource HwaySmallLabel}" />
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="#EEF6FF"
                                        Stroke="#BFDBFE"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,6"
                                        VerticalOptions="Start">
                                        <Label
                                            Text="{Binding Period, StringFormat='Period {0}'}"
                                            TextColor="#1D4ED8"
                                            FontSize="12"
                                            FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                                <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Start"
                                    JustifyContent="Start">

                                    <VerticalStackLayout WidthRequest="250" Spacing="8" Margin="0,0,22,8">
                                        <Label Text="Period" Style="{StaticResource HwaySubsectionTitle}" />
                                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                            <Label Grid.Row="0" Grid.Column="0" Text="Term" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding EmployerGroupDisplay}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="1" Grid.Column="0" Text="Beginning" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PeriodBeginningDisplay}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="2" Grid.Column="0" Text="Ending" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding PeriodEndingDisplay}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="3" Grid.Column="0" Text="Pay Date" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding PayDateDisplay}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="4" Grid.Column="0" Text="Saved" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding SavedAtDisplay}" Style="{StaticResource HwayValueLabel}" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout WidthRequest="300" Spacing="8" Margin="0,0,22,8">
                                        <Label Text="Earnings" Style="{StaticResource HwaySubsectionTitle}" />
                                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                            <Label Grid.Row="0" Grid.Column="0" Text="Salary" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Salary, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="1" Grid.Column="0" Text="Rate" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Rate, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="2" Grid.Column="0" Text="Regular Hours" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding RegularHours, StringFormat='{0:0.##}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="3" Grid.Column="0" Text="Overtime Hours" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding OvertimeHours, StringFormat='{0:0.##}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="4" Grid.Column="0" Text="Gross" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding Gross, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="5" Grid.Column="0" Text="Vacation" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding Vacation, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="6" Grid.Column="0" Text="Total Pay" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding TotalPay, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout WidthRequest="300" Spacing="8" Margin="0,0,22,8">
                                        <Label Text="Deductions" Style="{StaticResource HwaySubsectionTitle}" />
                                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                            <Label Grid.Row="0" Grid.Column="0" Text="Tax" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Tax1, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="1" Grid.Column="0" Text="CPP1" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Cpp1, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="2" Grid.Column="0" Text="CPP2" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Cpp2, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="3" Grid.Column="0" Text="EI" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Ei, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="4" Grid.Column="0" Text="Other" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding OtherDeduction, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="5" Grid.Column="0" Text="Total" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding TotalDeductions, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="6" Grid.Column="0" Text="Net Pay" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding NetPay, StringFormat='{0:0.00}'}" Style="{StaticResource HwayAmountLabel}" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout WidthRequest="320" Spacing="8" Margin="0,0,0,8">
                                        <Label Text="Year to Date" Style="{StaticResource HwaySubsectionTitle}" />
                                        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                            <Label Grid.Row="0" Grid.Column="0" Text="Gross YTD" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding GrossYtd, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="1" Grid.Column="0" Text="Net YTD" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding NetYtd, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="2" Grid.Column="0" Text="Total Pay YTD" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TotalPayYtd, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="3" Grid.Column="0" Text="Deductions YTD" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding TotalDeductionsYtd, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="4" Grid.Column="0" Text="Vacation Balance" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding VacationYtdBalance, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                            <Label Grid.Row="5" Grid.Column="0" Text="Total PD7" Style="{StaticResource HwayFieldLabel}" />
                                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding TotalPd7, StringFormat='{0:0.00}'}" Style="{StaticResource HwayValueLabel}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
