<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HWAY.Payroll.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F6F8FA"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Settings" Style="{StaticResource HwayPageTitle}" />
                    <Label Text="Pay periods, yearly limits, and payroll calculation values" Style="{StaticResource HwaySmallLabel}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Column="1"
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource HwayCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Year Reset" Style="{StaticResource HwaySectionTitle}" />
                            <Label Text="Clear live payroll totals and start period tracking again" Style="{StaticResource HwaySmallLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Reset Year"
                            Command="{Binding ResetYearCommand}"
                            Style="{StaticResource HwayDangerButton}"
                            VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="160,180,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Payroll year" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                            <Entry Text="{Binding ResetYear}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                        </Border>
                        <Label
                            Grid.Column="2"
                            Text="Keeps companies, employees, pay schedules, deduction limits, calculation values, payroll history, and PD7 records."
                            Style="{StaticResource HwaySmallLabel}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="3">
                <Label Text="Bi-weekly Settings" Style="{StaticResource HwaySectionTitle}" />
                <Label Text="Set the last period ending date and preview generated pay periods" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource HwayCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding ScheduleA.Name}" Style="{StaticResource HwaySectionTitle}" />
                                <Label Text="{Binding ScheduleA.ScheduleRange}" Style="{StaticResource HwaySmallLabel}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Save Bi-weekly A"
                                Command="{Binding SaveACommand}"
                                Style="{StaticResource HwaySaveButton}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid
                            ColumnDefinitions="170,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10"
                            ColumnSpacing="12">

                            <Label Grid.Row="0" Grid.Column="0" Text="Last period ending" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <DatePicker Date="{Binding ScheduleA.LastPeriodEnding}" Style="{StaticResource HwayDatePicker}" />
                            </Border>

                            <Label Grid.Row="1" Grid.Column="0" Text="Period 1 beginning" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ScheduleA.FirstPeriodBeginningDisplay}" Style="{StaticResource HwayValueLabel}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Period starts" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ScheduleA.ScheduleRange}" Style="{StaticResource HwayValueLabel}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Three-period months" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding ScheduleA.ThreePeriodMonths}" Style="{StaticResource HwayValueLabel}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                        <Grid
                            ColumnDefinitions="60,*,*,120"
                            RowDefinitions="Auto"
                            ColumnSpacing="8">

                            <Label Grid.Column="0" Text="Period" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="1" Text="Beginning" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="2" Text="Ending" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="3" Text="3-period" Style="{StaticResource HwayFieldLabel}" />
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding ScheduleA.Periods}"
                            HeightRequest="520"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        ColumnDefinitions="60,*,*,120"
                                        Padding="0,5"
                                        ColumnSpacing="8">

                                        <Label Grid.Column="0" Text="{Binding PeriodDisplay}" Style="{StaticResource HwayValueLabel}" />
                                        <Label Grid.Column="1" Text="{Binding BeginningDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                        <Label Grid.Column="2" Text="{Binding EndingDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                        <Label Grid.Column="3" Text="{Binding ThreePeriodMonthDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource HwayCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding ScheduleB.Name}" Style="{StaticResource HwaySectionTitle}" />
                                <Label Text="{Binding ScheduleB.ScheduleRange}" Style="{StaticResource HwaySmallLabel}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Save Bi-weekly B"
                                Command="{Binding SaveBCommand}"
                                Style="{StaticResource HwaySaveButton}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid
                            ColumnDefinitions="170,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10"
                            ColumnSpacing="12">

                            <Label Grid.Row="0" Grid.Column="0" Text="Last period ending" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <DatePicker Date="{Binding ScheduleB.LastPeriodEnding}" Style="{StaticResource HwayDatePicker}" />
                            </Border>

                            <Label Grid.Row="1" Grid.Column="0" Text="Period 1 beginning" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ScheduleB.FirstPeriodBeginningDisplay}" Style="{StaticResource HwayValueLabel}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Period starts" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ScheduleB.ScheduleRange}" Style="{StaticResource HwayValueLabel}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Three-period months" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding ScheduleB.ThreePeriodMonths}" Style="{StaticResource HwayValueLabel}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                        <Grid
                            ColumnDefinitions="60,*,*,120"
                            RowDefinitions="Auto"
                            ColumnSpacing="8">

                            <Label Grid.Column="0" Text="Period" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="1" Text="Beginning" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="2" Text="Ending" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="3" Text="3-period" Style="{StaticResource HwayFieldLabel}" />
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding ScheduleB.Periods}"
                            HeightRequest="520"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        ColumnDefinitions="60,*,*,120"
                                        Padding="0,5"
                                        ColumnSpacing="8">

                                        <Label Grid.Column="0" Text="{Binding PeriodDisplay}" Style="{StaticResource HwayValueLabel}" />
                                        <Label Grid.Column="1" Text="{Binding BeginningDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                        <Label Grid.Column="2" Text="{Binding EndingDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                        <Label Grid.Column="3" Text="{Binding ThreePeriodMonthDisplay}" Style="{StaticResource HwaySmallLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Button
                    Text="Save Both"
                    Command="{Binding SaveBothCommand}"
                    Style="{StaticResource HwaySaveButton}" />

                <Button
                    Text="Reload Saved"
                    Command="{Binding ReloadCommand}"
                    Style="{StaticResource HwaySecondaryButton}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="3" Margin="0,18,0,0">
                <Label Text="Yearly CPP/EI Limits" Style="{StaticResource HwaySectionTitle}" />
                <Label Text="Review saved yearly caps and update deduction maximums" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="420,*" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource HwayCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Saved Years" Style="{StaticResource HwaySectionTitle}" />
                                <Label Text="Select a year to edit its saved caps" Style="{StaticResource HwaySmallLabel}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Reload Limits"
                                Command="{Binding ReloadDeductionLimitsCommand}"
                                Style="{StaticResource HwaySecondaryButton}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="70,*,*,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Year" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="1" Text="CPP1" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="2" Text="CPP2" Style="{StaticResource HwayFieldLabel}" />
                            <Label Grid.Column="3" Text="EI" Style="{StaticResource HwayFieldLabel}" />
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding DeductionLimits}"
                            SelectedItem="{Binding SelectedDeductionLimit}"
                            SelectionMode="Single"
                            HeightRequest="180">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="70,*,*,*" Padding="8,6" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Year}" Style="{StaticResource HwayValueLabel}" />
                                        <Label Grid.Column="1" Text="{Binding Cpp1Maximum}" Style="{StaticResource HwaySmallLabel}" />
                                        <Label Grid.Column="2" Text="{Binding Cpp2Maximum}" Style="{StaticResource HwaySmallLabel}" />
                                        <Label Grid.Column="3" Text="{Binding EiMaximum}" Style="{StaticResource HwaySmallLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource HwayCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Edit Limits" Style="{StaticResource HwaySectionTitle}" />
                            <Label Text="Enter yearly CPP and EI maximums" Style="{StaticResource HwaySmallLabel}" />
                        </VerticalStackLayout>

                        <Grid
                            ColumnDefinitions="220,180"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10"
                            ColumnSpacing="12">

                            <Label Grid.Row="0" Grid.Column="0" Text="Year" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <Entry Text="{Binding DeductionLimitYear}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                            </Border>

                            <Label Grid.Row="1" Grid.Column="0" Text="Maximum CPP1" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <Entry Text="{Binding DeductionLimitCpp1Maximum}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                            </Border>

                            <Label Grid.Row="2" Grid.Column="0" Text="Maximum CPP2" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <Entry Text="{Binding DeductionLimitCpp2Maximum}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                            </Border>

                            <Label Grid.Row="3" Grid.Column="0" Text="Maximum EI" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <Entry Text="{Binding DeductionLimitEiMaximum}" Keyboard="Numeric" Style="{StaticResource HwayEntry}" />
                            </Border>
                        </Grid>

                        <Button
                            Text="Save Limits"
                            Command="{Binding SaveDeductionLimitCommand}"
                            Style="{StaticResource HwaySaveButton}"
                            HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="3" Margin="0,18,0,0">
                <Label Text="Payroll Calculations" Style="{StaticResource HwaySectionTitle}" />
                <Label Text="Edit stored calculation values, tax brackets, and province settings" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="320,*" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource HwayCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Stored Calculations" Style="{StaticResource HwaySectionTitle}" />
                                <Label Text="Select a calculation to edit" Style="{StaticResource HwaySmallLabel}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Reload"
                                Command="{Binding ReloadCalculationsCommand}"
                                Style="{StaticResource HwaySecondaryButton}"
                                VerticalOptions="Center" />
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding Calculations}"
                            SelectedItem="{Binding SelectedCalculation}"
                            SelectionMode="Single"
                            HeightRequest="300">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,7">
                                        <Label Text="{Binding DisplayName}" Style="{StaticResource HwayValueLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource HwayCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Edit Yearly Values" Style="{StaticResource HwaySectionTitle}" />
                                <Label Text="{Binding SelectedCalculation.DisplayName}" Style="{StaticResource HwaySmallLabel}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Save Yearly Values"
                                Command="{Binding SaveCalculationCommand}"
                                Style="{StaticResource HwaySaveButton}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid
                            ColumnDefinitions="220,180"
                            ColumnSpacing="12"
                            IsVisible="{Binding IsKnownCalculationSelected}">

                            <Label Grid.Column="0" Text="Effective date" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                <DatePicker Date="{Binding GuidedEffectiveDate}" Style="{StaticResource HwayDatePicker}" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout
                            Spacing="8"
                            IsVisible="{Binding ShowBasicGuidedFields}"
                            BindableLayout.ItemsSource="{Binding GuidedFields}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="320,180" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                            <Entry Text="{Binding Value}" Style="{StaticResource HwayEntry}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Spacing="14"
                            IsVisible="{Binding IsTaxCalculationSelected}">

                            <Label Text="General Tax Settings" Style="{StaticResource HwaySubsectionTitle}" />

                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding GuidedFields}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="320,180" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Value}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="Federal Amounts" Style="{StaticResource HwaySubsectionTitle}" />

                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding FederalFields}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="320,180" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Value}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="Federal Tax Brackets" Style="{StaticResource HwaySubsectionTitle}" />

                            <Grid ColumnDefinitions="160,120,160" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="Starts at income" Style="{StaticResource HwayFieldLabel}" />
                                <Label Grid.Column="1" Text="Rate (%)" Style="{StaticResource HwayFieldLabel}" />
                                <Label Grid.Column="2" Text="Subtract" Style="{StaticResource HwayFieldLabel}" />
                            </Grid>

                            <VerticalStackLayout
                                Spacing="6"
                                BindableLayout.ItemsSource="{Binding FederalTaxBrackets}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="160,120,160" ColumnSpacing="10">
                                            <Border Grid.Column="0" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Threshold}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Rate}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Constant}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="Province / Territory" Style="{StaticResource HwaySubsectionTitle}" />

                            <Border Style="{StaticResource HwayInputBorder}" WidthRequest="180" HorizontalOptions="Start">
                                <Picker
                                    ItemsSource="{Binding ProvinceCodes}"
                                    SelectedItem="{Binding SelectedProvinceCode}"
                                    Style="{StaticResource HwayPicker}" />
                            </Border>

                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding ProvinceFields}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="320,180" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{Binding Label}" Style="{StaticResource HwayFieldLabel}" VerticalOptions="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Value}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="Province Tax Brackets" Style="{StaticResource HwaySubsectionTitle}" />

                            <Grid ColumnDefinitions="160,120,160" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="Starts at income" Style="{StaticResource HwayFieldLabel}" />
                                <Label Grid.Column="1" Text="Rate (%)" Style="{StaticResource HwayFieldLabel}" />
                                <Label Grid.Column="2" Text="Subtract" Style="{StaticResource HwayFieldLabel}" />
                            </Grid>

                            <VerticalStackLayout
                                Spacing="6"
                                BindableLayout.ItemsSource="{Binding ProvinceTaxBrackets}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="160,120,160" ColumnSpacing="10">
                                            <Border Grid.Column="0" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Threshold}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Rate}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource HwayInputBorder}">
                                                <Entry Text="{Binding Constant}" Style="{StaticResource HwayEntry}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Spacing="8"
                                IsVisible="{Binding ShowHealthPremiumBands}">

                                <Label Text="Ontario Health Premium" Style="{StaticResource HwaySubsectionTitle}" />

                                <Grid ColumnDefinitions="120,120,120,100,120" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="Starts" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Grid.Column="1" Text="Ends" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Grid.Column="2" Text="Base" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Grid.Column="3" Text="Rate (%)" Style="{StaticResource HwayFieldLabel}" />
                                    <Label Grid.Column="4" Text="Maximum" Style="{StaticResource HwayFieldLabel}" />
                                </Grid>

                                <VerticalStackLayout
                                    Spacing="6"
                                    BindableLayout.ItemsSource="{Binding HealthPremiumBands}">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="120,120,120,100,120" ColumnSpacing="10">
                                                <Border Grid.Column="0" Style="{StaticResource HwayInputBorder}">
                                                    <Entry Text="{Binding Start}" Style="{StaticResource HwayEntry}" />
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource HwayInputBorder}">
                                                    <Entry Text="{Binding End}" Style="{StaticResource HwayEntry}" />
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource HwayInputBorder}">
                                                    <Entry Text="{Binding Base}" Style="{StaticResource HwayEntry}" />
                                                </Border>
                                                <Border Grid.Column="3" Style="{StaticResource HwayInputBorder}">
                                                    <Entry Text="{Binding Rate}" Style="{StaticResource HwayEntry}" />
                                                </Border>
                                                <Border Grid.Column="4" Style="{StaticResource HwayInputBorder}">
                                                    <Entry Text="{Binding Maximum}" Style="{StaticResource HwayEntry}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding Message}" Style="{StaticResource HwayErrorMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
