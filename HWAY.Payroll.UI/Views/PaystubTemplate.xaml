<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HWAY.Payroll.UI.Views.PaystubTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        HWAY Payroll Paystub Template
        Bind this ContentView to a PaystubViewModel.
        Replace Image Source="hway_logo.png" with your actual logo file name in Resources/Images.
    -->

    <ContentView.Resources>
        <Color x:Key="HeaderTeal">#348C9B</Color>
        <Color x:Key="Black">#000000</Color>

        <Style x:Key="Text" TargetType="Label">
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="BoldText" TargetType="Label" BasedOn="{StaticResource Text}">
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="TitleText" TargetType="Label" BasedOn="{StaticResource Text}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="RightText" TargetType="Label" BasedOn="{StaticResource Text}">
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>

        <Style x:Key="RightBoldText" TargetType="Label" BasedOn="{StaticResource BoldText}">
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>
    </ContentView.Resources>

    <AbsoluteLayout
        BackgroundColor="White"
        HeightRequest="1100"
        WidthRequest="850">

        <!-- Logo and title -->
        <Image
            Source="hway_logo.png"
            Aspect="AspectFit"
            AbsoluteLayout.LayoutBounds="100,112,95,95" />

        <Label
            Text="EARNING STATEMENT"
            Style="{StaticResource TitleText}"
            AbsoluteLayout.LayoutBounds="500,116,200,22" />

        <!-- Top teal bar and employer group -->
        <BoxView
            Color="{StaticResource HeaderTeal}"
            AbsoluteLayout.LayoutBounds="35,201,780,27" />

        <Label
            Text="{Binding EmployerGroup}"
            Style="{StaticResource Text}"
            AbsoluteLayout.LayoutBounds="742,192,50,16" />

        <!-- Employer / employee header section -->
		<Label Text="EMPLOYER" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,241,140,14" />
		<Label Text="{Binding EmployerName}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,253,250,14" />
		<Label Text="{Binding Address}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,264,270,14" />
		<Label Text="{Binding City}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,275,220,14" />
		<Label Text="{Binding PostalCode}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,286,120,14" />

        <Label Text="EMPLOYEE NO" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="440,241,100,14" />
        <Label Text="{Binding EmployeeNumber}" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="627,241,100,14" />

        <Label Text="EMPLOYEE" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,307,140,14" />
        <Label Text="{Binding EmployeeName}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,319,250,14" />
        <Label Text="{Binding EmployeeAddressLine}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,330,330,14" />

        <Label Text="PAY DATE:" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="635,307,70,14" />
        <Label Text="{Binding PayDate}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="698,307,100,14" />
        <Label Text="NET PAY  :" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="635,318,70,14" />
        <Label Text="$" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="680,318,20,14" />
        <Label Text="{Binding HeaderNetPay}" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="712,318,60,14" />

        <!-- Second teal bar -->
        <BoxView Color="{StaticResource HeaderTeal}" AbsoluteLayout.LayoutBounds="35,374,780,27" />

        <!-- Pay period section -->
        <Label Text="PAY PERIOD" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="610,425,90,14" />
        <Label Text="{Binding PayPeriod}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="706,425,70,14" />
        <Label Text="Period Beginning" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="610,436,100,14" />
        <Label Text="{Binding PeriodBeginning}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="698,436,100,14" />
        <Label Text="Period Ending" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="610,447,100,14" />
        <Label Text="{Binding PeriodEnding}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="698,447,100,14" />

        <!-- Benefits box -->
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,559,754,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,559,1,29" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="815,559,1,29" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,588,754,1" />

        <Label Text="BENEFITS" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,562,100,14" />
        <Label Text="Balance" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="452,562,80,14" />
        <Label Text="NET PAY:" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="618,562,80,14" />
        <Label Text="$" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="746,562,20,14" />
        <Label Text="{Binding BenefitNetPay}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="786,562,25,14" />
        <Label Text="Vacation" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,579,100,14" />
        <Label Text="{Binding VacationYtdBalance}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="458,579,40,14" />

        <!-- Memo -->
        <Label Text="MEMO:" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,621,80,14" />
        <Label Text="{Binding Memo}" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="115,621,650,14" />

        <!-- Dashed separator approximation -->
        <BoxView Color="#2A5EA8" AbsoluteLayout.LayoutBounds="35,680,750,1" />

        <!-- Pay table outer border -->
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,702,437,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,702,1,92" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="499,702,1,92" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,794,438,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,714,437,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="152,714,1,65" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="357,779,1,15" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,779,437,1" />

        <Label Text="PAY" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,703,80,12" />
        <Label Text="Salary" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="201,703,50,12" />
        <Label Text="Hours" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="267,703,50,12" />
        <Label Text="Rate" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="339,703,50,12" />
        <Label Text="Current" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="403,703,50,12" />
        <Label Text="YTD" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="463,703,35,12" />

        <Label Text="Regular Pay" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,718,100,12" />
        <Label Text="{Binding RegularPaySalary}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="198,718,50,12" />
        <Label Text="{Binding RegularPayHours}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="264,718,50,12" />
        <Label Text="{Binding RegularPayRate}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="333,718,50,12" />
        <Label Text="{Binding RegularPayCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,718,50,12" />
        <Label Text="{Binding RegularPayYtd}" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="459,718,38,12" />

        <Label Text="OV.T Pay" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,731,100,12" />
        <Label Text="{Binding OvertimePaySalary}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="198,731,50,12" />
        <Label Text="{Binding OvertimePayHours}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="264,731,50,12" />
        <Label Text="{Binding OvertimePayRate}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="333,731,50,12" />
        <Label Text="{Binding OvertimePayCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,731,50,12" />
        <Label Text="{Binding OvertimePayYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="459,731,38,12" />

        <Label Text="Public" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,744,100,12" />
        <Label Text="{Binding PublicHolidaySalary}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="198,744,50,12" />
        <Label Text="{Binding PublicHolidayHours}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="264,744,50,12" />
        <Label Text="{Binding PublicHolidayRate}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="333,744,50,12" />
        <Label Text="{Binding PublicHolidayCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,744,50,12" />
        <Label Text="{Binding PublicHolidayYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="459,744,38,12" />

        <Label Text="Statutory Holiday" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,757,100,12" />
        <Label Text="{Binding StatHolidaySalary}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="198,757,50,12" />
        <Label Text="{Binding StatHolidayHours}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="264,757,50,12" />
        <Label Text="{Binding StatHolidayRate}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="333,757,50,12" />
        <Label Text="{Binding StatHolidayCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,757,50,12" />
        <Label Text="{Binding StatHolidayYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="459,757,38,12" />

        <Label Text="Vacation Pay" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,770,100,12" />
        <Label Text="{Binding VacationPayCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,770,50,12" />
        <Label Text="{Binding VacationPayYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="459,770,38,12" />

        <Label Text="Total Pay" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,782,100,12" />
        <Label Text="{Binding TotalPayCurrent}" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="397,782,50,12" />
        <Label Text="{Binding TotalPayYtd}" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="459,782,38,12" />

        <!-- Taxes table -->
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="602,702,213,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="602,702,1,92" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="815,702,1,92" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="602,794,214,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="602,714,213,1" />

        <Label Text="Taxes" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="605,703,80,12" />
        <Label Text="Current" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="695,703,55,12" />
        <Label Text="YTD" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="780,703,30,12" />

        <Label Text="Tax" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="605,718,80,12" />
        <Label Text="{Binding TaxCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="706,718,45,12" />
        <Label Text="{Binding TaxYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="770,718,40,12" />

        <Label Text="CPP1" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="605,731,80,12" />
        <Label Text="{Binding Cpp1Current}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="706,731,45,12" />
        <Label Text="{Binding Cpp1Ytd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="770,731,40,12" />

        <Label Text="CPP2" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="605,744,80,12" />
        <Label Text="{Binding Cpp2Current}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="706,744,45,12" />
        <Label Text="{Binding Cpp2Ytd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="770,744,40,12" />

        <Label Text="EI" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="605,757,80,12" />
        <Label Text="{Binding EiCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="706,757,45,12" />
        <Label Text="{Binding EiYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="770,757,40,12" />

        <Label Text="Other Deduction" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="605,770,100,12" />
        <Label Text="{Binding OtherDeductionCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="706,770,45,12" />
        <Label Text="{Binding OtherDeductionYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="770,770,40,12" />

        <!-- Summary table -->
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,839,370,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,839,1,74" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="432,839,1,74" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,913,371,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,851,370,1" />
        <BoxView Color="Black" AbsoluteLayout.LayoutBounds="62,896,370,1" />

        <Label Text="SUMMARY" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,840,100,12" />
        <Label Text="Current" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="258,840,60,12" />
        <Label Text="YTD" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="400,840,30,12" />

        <Label Text="Total Pay" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,856,100,12" />
        <Label Text="{Binding SummaryTotalPayCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="260,856,40,12" />
        <Label Text="{Binding SummaryTotalPayYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,856,32,12" />

        <Label Text="Taxes" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,871,100,12" />
        <Label Text="{Binding SummaryTaxesCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="260,871,40,12" />
        <Label Text="{Binding SummaryTaxesYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,871,32,12" />

        <Label Text="Deductions" Style="{StaticResource Text}" AbsoluteLayout.LayoutBounds="65,886,100,12" />
        <Label Text="{Binding SummaryDeductionsCurrent}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="260,886,40,12" />
        <Label Text="{Binding SummaryDeductionsYtd}" Style="{StaticResource RightText}" AbsoluteLayout.LayoutBounds="397,886,32,12" />

        <Label Text="Net Pay" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="65,901,100,12" />
        <Label Text="$" Style="{StaticResource BoldText}" AbsoluteLayout.LayoutBounds="229,901,20,12" />
        <Label Text="{Binding SummaryNetPayCurrent}" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="260,901,40,12" />
        <Label Text="{Binding SummaryNetPayYtd}" Style="{StaticResource RightBoldText}" AbsoluteLayout.LayoutBounds="397,901,32,12" />

        <!-- Bottom teal bar -->
        <BoxView Color="{StaticResource HeaderTeal}" AbsoluteLayout.LayoutBounds="35,998,780,27" />
    </AbsoluteLayout>
</ContentView>
