<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.PayrollRecordEditPage"
    BackgroundColor="#F6F8FA"
    Title="Edit Payroll Record">

    <ContentPage.Resources>
        <Style x:Key="PageTitle" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#0F172A" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1F2937" />
        </Style>

        <Style x:Key="SubsectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#334155" />
        </Style>

        <Style x:Key="SmallLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#64748B" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#475569" />
        </Style>

        <Style x:Key="ValueLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#111827" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#D9E2EC" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="Stroke" Value="#CBD5E1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>

        <Style x:Key="ReadOnlyInputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F1F5F9" />
            <Setter Property="Stroke" Value="#D9E2EC" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1D4ED8" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#475569" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style x:Key="SaveActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#15803D" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>

        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="TitleColor" Value="#64748B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <VerticalStackLayout Spacing="3">
                <Label
                    Text="Edit Payroll Record"
                    Style="{StaticResource PageTitle}" />
                <Label
                    Text="Search, adjust, recalculate, and save existing payroll records"
                    Style="{StaticResource SmallLabel}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Payroll Record Lookup" Style="{StaticResource SectionTitle}" />
                        <Label Text="Search by employee or employer details" Style="{StaticResource SmallLabel}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Search" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Employee #, employee name, employer #, or employer name"
                                    Keyboard="Text"
                                    Text="{Binding SearchText}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Search Records"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryActionButton}"
                            VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <CollectionView
                ItemsSource="{Binding SearchResults}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedPayrollRecord}"
                IsVisible="{Binding SearchResultsFound}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#FFFFFF"
                            Stroke="#D9E2EC"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">

                            <Grid ColumnDefinitions="*,180,220" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        Text="{Binding EmployeeName}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#111827" />

                                    <Label
                                        Text="{Binding EmployeeNumber, StringFormat='Employee #: {0}'}"
                                        Style="{StaticResource SmallLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Employer RP" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding RpNumber}" Style="{StaticResource ValueLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Employer" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding EmployerName}" Style="{StaticResource ValueLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border
                IsVisible="{Binding EmployeeNotFound}"
                BackgroundColor="#FEF2F2"
                Stroke="#FCA5A5"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Padding="12">
                <Label
                    Text="No payroll records found."
                    TextColor="#B91C1C"
                    FontAttributes="Bold" />
            </Border>

            <Label
                Text="{Binding Message}"
                FontAttributes="Bold"
                TextColor="#B91C1C"
                HorizontalOptions="Center" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Selected Payroll Record" Style="{StaticResource SectionTitle}" />
                            <Label Text="Edit employee details, earnings, and deductions" Style="{StaticResource SmallLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Save Changes"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SaveActionButton}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                            <Label Text="Employee Information" Style="{StaticResource SubsectionTitle}" />

                            <Grid
                                ColumnDefinitions="120,*"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <Label Grid.Row="0" Grid.Column="0" Text="Employee #" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Employee Number" Text="{Binding EmployeeNumber}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="RP Number" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="RP Number" Text="{Binding RpNumber}" />
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="Employee Name" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Employee Name" Text="{Binding EmployeeName}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                            <Label Text="Earnings" Style="{StaticResource SubsectionTitle}" />

                            <Grid
                                ColumnDefinitions="120,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <Label Grid.Row="0" Grid.Column="0" Text="Salary" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Salary" Keyboard="Numeric" Text="{Binding Salary}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="Rate" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Rate" Keyboard="Numeric" Text="{Binding Rate}" />
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="Regular Hours" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Regular Hours" Keyboard="Numeric" Text="{Binding RegularHours}" />
                                </Border>

                                <Label Grid.Row="3" Grid.Column="0" Text="Overtime Hours" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Overtime Hours" Keyboard="Numeric" Text="{Binding OvertimeHours}" />
                                </Border>

                                <Label Grid.Row="4" Grid.Column="0" Text="Vacation" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ReadOnlyInputBorder}">
                                    <Entry Placeholder="Vacation" Keyboard="Numeric" Text="{Binding Vacation}" IsReadOnly="True" />
                                </Border>

                                <Label Grid.Row="5" Grid.Column="0" Text="Vacation Setting" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Picker
                                        ItemsSource="{Binding VacationSettingOptions}"
                                        SelectedItem="{Binding VacationSetting}"
                                        Title="Vacation setting" />
                                </Border>

                                <Label Grid.Row="6" Grid.Column="0" Text="Gross" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource ReadOnlyInputBorder}">
                                    <Entry Placeholder="Gross" Keyboard="Numeric" Text="{Binding Gross}" IsReadOnly="True" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                            <Label Text="Deductions" Style="{StaticResource SubsectionTitle}" />

                            <Grid
                                ColumnDefinitions="120,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <Label Grid.Row="0" Grid.Column="0" Text="Tax" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Tax" Keyboard="Numeric" Text="{Binding Tax1}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="CPP1" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="CPP1" Keyboard="Numeric" Text="{Binding Cpp1}" IsEnabled="{Binding CanEditCpp1}" />
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="CPP2" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="CPP2" Keyboard="Numeric" Text="{Binding Cpp2}" IsEnabled="{Binding CanEditCpp2}" />
                                </Border>

                                <Label Grid.Row="3" Grid.Column="0" Text="EI" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="EI" Keyboard="Numeric" Text="{Binding Ei}" IsEnabled="{Binding CanEditEi}" />
                                </Border>

                                <Label Grid.Row="4" Grid.Column="0" Text="Other Deduction" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Other Deduction" Keyboard="Numeric" Text="{Binding OtherDeduction}" />
                                </Border>

                                <Label Grid.Row="5" Grid.Column="0" Text="Net Pay" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource InputBorder}">
                                    <Entry Placeholder="Net Pay" Keyboard="Numeric" Text="{Binding NetPay}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <HorizontalStackLayout Spacing="10">
                        <Button
                            Text="Recalculate Payroll Deductions"
                            Command="{Binding CalculatePayrollCommand}"
                            Style="{StaticResource PrimaryActionButton}" />

                        <Button
                            Text="Save Changes"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SaveActionButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
