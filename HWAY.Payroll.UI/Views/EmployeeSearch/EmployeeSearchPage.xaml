<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HWAY.Payroll.UI.Views.EmployeeSearchPage"
    x:Name="ThisPage"
    BackgroundColor="#F6F8FA"
    Title="Employee Search">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="18">

        <VerticalStackLayout Grid.Row="0" Spacing="18">
            <VerticalStackLayout Spacing="3">
                <Label Text="Employee Search" Style="{StaticResource HwayPageTitle}" />
                <Label Text="Find employees by RP number, employee number, or name" Style="{StaticResource HwaySmallLabel}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource HwayCardBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Search" Style="{StaticResource HwayFieldLabel}" />
                        <Border Style="{StaticResource HwayInputBorder}">
                            <Entry
                                Placeholder="Search by RP, Employee #, or Name"
                                Text="{Binding SearchText}"
                                Style="{StaticResource HwayEntry}" />
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource HwayPrimaryButton}"
                        VerticalOptions="End" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Employees}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="#FFFFFF"
                        Stroke="#D9E2EC"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEmployeeCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,180,180" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label
                                    Text="{Binding FirstName}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                                <Label Text="{Binding LastName}" Style="{StaticResource HwaySmallLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="RP Number" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding RpNumber}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Employee #" Style="{StaticResource HwayFieldLabel}" />
                                <Label Text="{Binding EmployeeNumber}" Style="{StaticResource HwayValueLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
