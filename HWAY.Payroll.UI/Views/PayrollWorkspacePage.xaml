<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HWAY.Payroll.UI.Views.PayrollWorkspacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Payroll Workspace">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label
                Text="Search by RP number or employer name"
                FontSize="14" />

            <Entry
                Placeholder="Enter RP number or employer name"
                Text="{Binding SearchText}"
                ReturnCommand="{Binding SearchCommand}" />

            <Border
                IsVisible="{Binding IsDropdownVisible}"
                StrokeThickness="1"
                Padding="0"
                HeightRequest="220">

                <CollectionView
                    ItemsSource="{Binding Employers}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployerCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Text="{Binding RpNumber}"
                                        FontAttributes="Bold"
                                        FontSize="16" />

                                    <Label
                                        Text="{Binding EmployerName}"
                                        FontSize="14" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}" />

            <Border
                StrokeThickness="1"
                Padding="16"
                Margin="0,12,0,0">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Selected Employer"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Grid
                        ColumnDefinitions="140,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="8">

                        <Label Grid.Row="0" Grid.Column="0" Text="RP Number:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEmployer.RpNumber}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Employer Name:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEmployer.EmployerName}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Address:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEmployer.Address}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="City:" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEmployer.City}" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Postal Code:" FontAttributes="Bold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEmployer.PostalCode}" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Group:" FontAttributes="Bold" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEmployer.EmployerGroup}" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Period #:" FontAttributes="Bold" />
                        <Label Grid.Row="6" Grid.Column="1" Text="{Binding SelectedEmployer.PaystubPeriod}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding Message}"
                FontAttributes="Bold"
                TextColor="Green" />

            <Label
                IsVisible="{Binding EmployeeNotFound}"
                Text="No employees found for this employer."
                TextColor="Red"
                FontAttributes="Bold" />

            <VerticalStackLayout
                IsVisible="{Binding SearchResultsFound}"
                Spacing="14">

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding EmployeePayrollRows}"
                    Spacing="14">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Stroke="Red"
                                StrokeThickness="1"
                                Padding="16"
                                Margin="0,10,0,0">

                            <VerticalStackLayout Spacing="14">

                                <Label
                                    Text="{Binding EmployeeName}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding EmployeeNumber, StringFormat='Employee #: {0}'}"
                                    FontSize="13" />

                                <Grid
                                    ColumnDefinitions="Auto,160,40,Auto,160,40,Auto,160"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                    ColumnSpacing="12"
                                    RowSpacing="8">

                                    <Label Grid.Row="0" Grid.Column="0" Text="Salary" VerticalOptions="Center" />
                                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Salary}" Keyboard="Numeric" />

                                    <Label Grid.Row="1" Grid.Column="0" Text="Rate" VerticalOptions="Center" />
                                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Rate}" Keyboard="Numeric" />

                                    <Label Grid.Row="2" Grid.Column="0" Text="R. Hours" VerticalOptions="Center" />
                                    <Entry Grid.Row="2" Grid.Column="1" Text="{Binding RegularHours}" Keyboard="Numeric" />

                                    <Label Grid.Row="3" Grid.Column="0" Text="OT Hours" VerticalOptions="Center" />
                                    <Entry Grid.Row="3" Grid.Column="1" Text="{Binding OvertimeHours}" Keyboard="Numeric" />

                                    <Label Grid.Row="4" Grid.Column="0" Text="Public H." VerticalOptions="Center" />
                                    <Entry Grid.Row="4" Grid.Column="1" Text="{Binding PublicHolidayHours}" Keyboard="Numeric" />

                                    <Label Grid.Row="5" Grid.Column="0" Text="Stat H." VerticalOptions="Center" />
                                    <Entry Grid.Row="5" Grid.Column="1" Text="{Binding StatHolidayHours}" Keyboard="Numeric" />

                                    <Label Grid.Row="6" Grid.Column="0" Text="Pay Date" VerticalOptions="Center" />
                                    <DatePicker Grid.Row="6" Grid.Column="1" Date="{Binding PayDateDisplay}" />

                                    <Label Grid.Row="7" Grid.Column="0" Text="Vacation Setting" VerticalOptions="Center" />
                                    <Picker
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        ItemsSource="{Binding VacationSettingOptions}"
                                        SelectedItem="{Binding VacationSetting}"
                                        Title="Vacation setting" />

                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="6"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="2"
                                        StrokeThickness="2"
                                        Padding="15">

                                        <Grid
                                            ColumnDefinitions="Auto,120"
                                            RowDefinitions="Auto,Auto"
                                            RowSpacing="12"
                                            ColumnSpacing="12">

                                            <Label Grid.Row="0" Grid.Column="0" Text="Gross:" FontAttributes="Italic" VerticalOptions="Center" />
                                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Gross}" IsReadOnly="True" Keyboard="Numeric" />

                                            <Label Grid.Row="1" Grid.Column="0" Text="Vacation:" FontAttributes="Italic" VerticalOptions="Center" />
                                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Vacation}" IsReadOnly="True" Keyboard="Numeric" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="6"
                                        Grid.Column="6"
                                        Grid.ColumnSpan="2"
                                        StrokeThickness="2"
                                        Padding="15">

                                        <Grid
                                            ColumnDefinitions="Auto,120"
                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                            RowSpacing="12"
                                            ColumnSpacing="12">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Text="Vacation Used:"
                                                FontAttributes="Italic"
                                                VerticalOptions="Center" />

                                            <Entry
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="{Binding VacationUsed}"
                                                IsEnabled="{Binding CanEditVacationUsed}"
                                                Keyboard="Numeric" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Text="Vacation YTD:"
                                                FontAttributes="Italic"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding VacationYtd, StringFormat='{0:0.00}'}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Text="Vacation Balance:"
                                                FontAttributes="Italic"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="{Binding VacationYtdBalance, StringFormat='{0:0.00}'}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Text="Vacation Used YTD:"
                                                FontAttributes="Italic"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Text="{Binding VacationYtdUsed, StringFormat='{0:0.00}'}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Button
                                    Text="Calculate Payroll &amp; Open CRA Tax Calculator"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CalculateRowCommand}"
                                    CommandParameter="{Binding .}"
                                    HorizontalOptions="Start"
                                    WidthRequest="330" />

                                <Grid
                                    ColumnDefinitions="Auto,160,80,160"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                    ColumnSpacing="12"
                                    RowSpacing="8">

                                    <Label Grid.Row="0" Grid.Column="0" Text="Tax" VerticalOptions="Center" />
                                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Tax1}" Keyboard="Numeric" />

                                    <Label Grid.Row="1" Grid.Column="0" Text="CPP1" VerticalOptions="Center" />
                                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Cpp1}" Keyboard="Numeric" IsEnabled="{Binding CanEditCpp1}" />

                                    <Label Grid.Row="2" Grid.Column="0" Text="CPP2" VerticalOptions="Center" />
                                    <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Cpp2}" Keyboard="Numeric" IsEnabled="{Binding CanEditCpp2}" />

                                    <Label Grid.Row="3" Grid.Column="0" Text="EI" VerticalOptions="Center" />
                                    <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Ei}" Keyboard="Numeric" IsEnabled="{Binding CanEditEi}" />

                                    <Label Grid.Row="4" Grid.Column="0" Text="Other Deductions" VerticalOptions="Center" />
                                    <Entry Grid.Row="4" Grid.Column="1" Text="{Binding OtherDeduction}" Keyboard="Numeric" />

                                    <VerticalStackLayout
                                        Grid.Row="0"
                                        Grid.RowSpan="5"
                                        Grid.Column="3"
                                        Spacing="8"
                                        VerticalOptions="Start">

                                        <Button
                                            Text="Preview Paystub"
                                            Clicked="PreviewPaystubButton_Clicked" />

                                        <Button
                                            Text="Print Paystub"
                                            Clicked="PrintPaystubButton_Clicked" />

                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button
                    Text="Save All Employees"
                    Command="{Binding SaveAllRowsCommand}"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    Margin="0,8,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
