<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HWAY.Payroll.UI.Views.PayrollWorkspacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F6F8FA"
    Title="Payroll Workspace">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1F2937" />
        </Style>

        <Style x:Key="SubsectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#334155" />
        </Style>

        <Style x:Key="PageTitle" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#0F172A" />
        </Style>

        <Style x:Key="SmallLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#64748B" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#475569" />
        </Style>

        <Style x:Key="ValueLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#111827" />
        </Style>

        <Style x:Key="AmountLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#0F172A" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#D9E2EC" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="Stroke" Value="#CBD5E1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>

        <Style x:Key="ReadOnlyInputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F1F5F9" />
            <Setter Property="Stroke" Value="#D9E2EC" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>

        <Style x:Key="DropdownBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#CBD5E1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1D4ED8" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#475569" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style x:Key="PrintActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#0F766E" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style x:Key="SaveActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#15803D" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>

        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="TitleColor" Value="#64748B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <VerticalStackLayout Spacing="3">
                <Label
                    Text="Payroll Workspace"
                    Style="{StaticResource PageTitle}" />
                <Label
                    Text="Employer payroll records and paystub preparation"
                    Style="{StaticResource SmallLabel}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Company Lookup" Style="{StaticResource SectionTitle}" />
                            <Label Text="Search by RP number or employer name" Style="{StaticResource SmallLabel}" />
                        </VerticalStackLayout>

                        <ActivityIndicator
                            Grid.Column="1"
                            IsVisible="{Binding IsBusy}"
                            IsRunning="{Binding IsBusy}"
                            VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Company" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry
                                Placeholder="Enter RP number or employer name"
                                Text="{Binding SearchText}"
                                ReturnCommand="{Binding SearchCommand}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding IsDropdownVisible}"
                        Style="{StaticResource DropdownBorder}"
                        HeightRequest="220">

                        <CollectionView
                            ItemsSource="{Binding Employers}"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14,12" ColumnDefinitions="150,*" ColumnSpacing="14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEmployerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding RpNumber}"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding EmployerName}"
                                            TextColor="#334155"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selected Employer" Style="{StaticResource SectionTitle}" />

                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start"
                            JustifyContent="Start">

                            <VerticalStackLayout WidthRequest="220" Spacing="2" Margin="0,0,18,8">
                                <Label Text="RP Number" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.RpNumber}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="300" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Employer Name" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.EmployerName}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="300" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Address" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.Address}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="180" Spacing="2" Margin="0,0,18,8">
                                <Label Text="City" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.City}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Postal Code" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.PostalCode}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="150" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Group" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.EmployerGroup}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout WidthRequest="120" Spacing="2" Margin="0,0,18,8">
                                <Label Text="Period #" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding SelectedEmployer.PaystubPeriod}" Style="{StaticResource ValueLabel}" />
                            </VerticalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding Message}"
                FontAttributes="Bold"
                TextColor="#166534"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding EmployeeNotFound}"
                BackgroundColor="#FEF2F2"
                Stroke="#FCA5A5"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Padding="12">
                <Label
                    Text="No employees found for this employer."
                    TextColor="#B91C1C"
                    FontAttributes="Bold" />
            </Border>

            <VerticalStackLayout
                IsVisible="{Binding SearchResultsFound}"
                Spacing="14">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Employee Payroll" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding SelectedEmployer.PaystubPeriod, StringFormat='Current period: {0}'}" Style="{StaticResource SmallLabel}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button
                            Text="Print All Pay Stubs"
                            Clicked="PrintAllPaystubsButton_Clicked"
                            Style="{StaticResource PrintActionButton}" />

                        <Button
                            Text="Save All Employees"
                            Command="{Binding SaveAllRowsCommand}"
                            Style="{StaticResource SaveActionButton}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding EmployeePayrollRows}"
                    Spacing="14">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="14">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <Label
                                                Text="{Binding EmployeeName}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="#111827" />

                                            <Label
                                                Text="{Binding EmployeeNumber, StringFormat='Employee #: {0}'}"
                                                Style="{StaticResource SmallLabel}" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="#EEF6FF"
                                            Stroke="#BFDBFE"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,6"
                                            VerticalOptions="Start">
                                            <Label
                                                Text="{Binding Period, StringFormat='Period {0}'}"
                                                TextColor="#1D4ED8"
                                                FontSize="12"
                                                FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Start"
                                        JustifyContent="Start">

                                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                                            <Label Text="Earnings" Style="{StaticResource SubsectionTitle}" />

                                            <Grid
                                                ColumnDefinitions="120,*"
                                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                ColumnSpacing="10"
                                                RowSpacing="8">

                                                <Label Grid.Row="0" Grid.Column="0" Text="Salary" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Salary}" Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="1" Grid.Column="0" Text="Rate" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Rate}" Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="2" Grid.Column="0" Text="Regular Hours" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding RegularHours}" Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="3" Grid.Column="0" Text="OT Hours" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding OvertimeHours}" Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="4" Grid.Column="0" Text="Public H." Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding PublicHolidayHours}" Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="5" Grid.Column="0" Text="Stat H." Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding StatHolidayHours}" Keyboard="Numeric" />
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                                            <Label Text="Pay and Vacation" Style="{StaticResource SubsectionTitle}" />

                                            <Grid
                                                ColumnDefinitions="120,*"
                                                RowDefinitions="Auto,Auto,Auto,Auto"
                                                ColumnSpacing="10"
                                                RowSpacing="8">

                                                <Label Grid.Row="0" Grid.Column="0" Text="Pay Date" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <DatePicker Date="{Binding PayDateDisplay}" />
                                                </Border>

                                                <Label Grid.Row="1" Grid.Column="0" Text="Vacation Setting" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBorder}">
                                                    <Picker
                                                        ItemsSource="{Binding VacationSettingOptions}"
                                                        SelectedItem="{Binding VacationSetting}"
                                                        Title="Vacation setting" />
                                                </Border>

                                                <Label Grid.Row="2" Grid.Column="0" Text="Gross" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyInputBorder}">
                                                    <Entry Text="{Binding Gross}" IsReadOnly="True" Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="3" Grid.Column="0" Text="Vacation" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ReadOnlyInputBorder}">
                                                    <Entry Text="{Binding Vacation}" IsReadOnly="True" Keyboard="Numeric" />
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout WidthRequest="330" Spacing="10" Margin="0,0,24,8">
                                            <Label Text="Vacation Balance" Style="{StaticResource SubsectionTitle}" />

                                            <Grid
                                                ColumnDefinitions="140,*"
                                                RowDefinitions="Auto,Auto,Auto,Auto"
                                                ColumnSpacing="10"
                                                RowSpacing="8">

                                                <Label Grid.Row="0" Grid.Column="0" Text="Vacation Used" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Style="{StaticResource InputBorder}">
                                                    <Entry
                                                        Text="{Binding VacationUsed}"
                                                        IsEnabled="{Binding CanEditVacationUsed}"
                                                        Keyboard="Numeric" />
                                                </Border>

                                                <Label Grid.Row="1" Grid.Column="0" Text="Vacation YTD" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding VacationYtd, StringFormat='{0:0.00}'}" Style="{StaticResource ValueLabel}" VerticalOptions="Center" />

                                                <Label Grid.Row="2" Grid.Column="0" Text="Balance" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding VacationYtdBalance, StringFormat='{0:0.00}'}" Style="{StaticResource AmountLabel}" VerticalOptions="Center" />

                                                <Label Grid.Row="3" Grid.Column="0" Text="Used YTD" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding VacationYtdUsed, StringFormat='{0:0.00}'}" Style="{StaticResource ValueLabel}" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </FlexLayout>

                                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="Deductions" Style="{StaticResource SubsectionTitle}" />
                                                <Label Text="Tax, CPP, EI, and other deductions" Style="{StaticResource SmallLabel}" />
                                            </VerticalStackLayout>

                                            <Button
                                                Grid.Column="1"
                                                Text="Calculate Payroll Deductions"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CalculateRowCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource PrimaryActionButton}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <FlexLayout
                                            Direction="Row"
                                            Wrap="Wrap"
                                            AlignItems="Start"
                                            JustifyContent="Start">

                                            <VerticalStackLayout WidthRequest="150" Spacing="6" Margin="0,0,12,8">
                                                <Label Text="Tax" Style="{StaticResource FieldLabel}" />
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Tax1}" Keyboard="Numeric" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout WidthRequest="150" Spacing="6" Margin="0,0,12,8">
                                                <Label Text="CPP1" Style="{StaticResource FieldLabel}" />
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Cpp1}" Keyboard="Numeric" IsEnabled="{Binding CanEditCpp1}" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout WidthRequest="150" Spacing="6" Margin="0,0,12,8">
                                                <Label Text="CPP2" Style="{StaticResource FieldLabel}" />
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Cpp2}" Keyboard="Numeric" IsEnabled="{Binding CanEditCpp2}" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout WidthRequest="150" Spacing="6" Margin="0,0,12,8">
                                                <Label Text="EI" Style="{StaticResource FieldLabel}" />
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding Ei}" Keyboard="Numeric" IsEnabled="{Binding CanEditEi}" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout WidthRequest="180" Spacing="6" Margin="0,0,18,8">
                                                <Label Text="Other Deductions" Style="{StaticResource FieldLabel}" />
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding OtherDeduction}" Keyboard="Numeric" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Spacing="10" Margin="0,22,0,8">
                                                <Button
                                                    Text="Preview Paystub"
                                                    Clicked="PreviewPaystubButton_Clicked"
                                                    Style="{StaticResource SecondaryActionButton}" />

                                                <Button
                                                    Text="Print Paystub"
                                                    Clicked="PrintPaystubButton_Clicked"
                                                    Style="{StaticResource PrintActionButton}" />
                                            </HorizontalStackLayout>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Button
                        Text="Print All Pay Stubs"
                        Clicked="PrintAllPaystubsButton_Clicked"
                        Style="{StaticResource PrintActionButton}"
                        HorizontalOptions="Fill" />

                    <Button
                        Text="Save All Employees"
                        Command="{Binding SaveAllRowsCommand}"
                        Style="{StaticResource SaveActionButton}"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
